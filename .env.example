# Ollama (OpenAI-compatible API) — default LLM backend
OLLAMA_BASE_URL=http://localhost:11434/v1
# Speed/quality on ~8GB RAM: qwen2.5:1.5b (fastest, weaker ranking) < qwen2.5:3b (good balance) < qwen2.5:7b (best)
OLLAMA_MODEL=qwen2.5:3b
# Performance: keep model warm between calls; bound context for faster prefill
OLLAMA_KEEP_ALIVE=15m
OLLAMA_NUM_CTX=4096
# LLM speed knobs (smaller = faster)
RANK_PREVIEW_CHARS=500
SUMMARY_TEXT_CHARS=1000
# MAX_TO_RANK=12
SUMMARY_LLM_RETRY=0   # 0 = skip slow per-article summary retries (extractive fallback)
SUMMARY_LLM=0         # 0 = headline + discovery snippet only (no summary LLM; fastest)
# RANK_LLM=0          # 0 = keyword ranking only (no Ollama required)
# Ollama ignores this; any non-empty value works. Leave as "ollama".
OPENAI_API_KEY=ollama

# News discovery — hybrid runs NewsAPI + Event Registry + DDGS/RSS/outlets together when keys are set.
# split = regional API routing (NewsAPI Europe/NA, ER elsewhere) + DDGS/RSS supplement.
DISCOVERY_SOURCE=hybrid
NEWS_API_KEY=
# NewsAPI auto-enables when NEWS_API_KEY is set (hybrid/split/api). Set ENABLE_NEWSAPI=1 for legacy modes.
# ENABLE_NEWSAPI=0
DISCOVERY_SUPPLEMENT=1
DISCOVER_WORKERS=8
FETCH_WORKERS=6
FAST_RANK=1
# Min relevance score (0-100) to include an article. Lower = more results.
RELEVANCE_THRESHOLD=32
# Regional balance (soft): boost + diversity for these regions, no hard filter so
# global stories still appear. Use "global" for pure relevance with no preference.
DEFAULT_GEOGRAPHIC_REGIONS=europe,north_america,asia,africa,latin_america,middle_east
RANK_GEO_DIVERSITY=1
RANK_MAX_PER_GEO=2
REGION_RANK_BOOST=20
ENABLE_BROAD_NEWS=1
ENABLE_OUTLET_FEEDS=1
ENABLE_REDDIT=1
DISCOVERY_MAX_CANDIDATES=220
DISCOVERY_FALLBACK_DDGS=1

# Discovery speed: each DDGS region is a separate rate-limited call. Lower = faster.
DDGS_MAX_REGIONS=8
DDGS_PER_REGION=16

# Optional DDGS region codes (see src/regions.py); thematic UI regions override when set
# DDGS_REGIONS=in-en,jp-jp,za-en,ng-en,br-pt,mx-es,ar-es

# NewsAPI: set NEWS_API_USE_SOURCES=1 to limit to wire services only
# NEWS_API_USE_SOURCES=0

# NewsAPI.org — disabled by default (weak regional coverage). ENABLE_NEWSAPI=1 to use.
# NEWS_API_KEY=your-key-here
# RANK_USE_ER_SCORE=1
# EVENTREGISTRY_QUERY_MODE=ai_export
# EVENTREGISTRY_REGIONAL_SUPPLEMENT=1
# EVENTREGISTRY_TOPIC_SUPPLEMENT=1
# EVENTREGISTRY_CREATIVE_SUPPLEMENT=18
# EVENTREGISTRY_INFORMAL_WORK_SUPPLEMENT=18
# DISCOVERY_FALLBACK_DDGS=1
# NEWSAPI_MIN_BEFORE_SUPPLEMENT=8
# NEWS_API_USE_SOURCES=0

# Event Registry / newsapi.ai (https://eventregistry.org) — optional extra hybrid source
# 150k+ sources, 60+ languages. Free tier is token-limited. Stays off until the key is set.
ENABLE_EVENTREGISTRY=1
# EVENTREGISTRY_API_KEY=your-key-here
# Concept-based AI+labour search sorted by relevance; primary discovery source.
EVENTREGISTRY_MAX_RESULTS=100
# Labor-impact charts: ER live + per-year cache + DDGS/RSS/Reddit supplements
VIZ_FOCUS_REGIONS=africa,latin_america,middle_east
VIZ_GEO_BALANCE=1
VIZ_MIN_PER_FOCUS_REGION=25
VIZ_ER_PER_THEME=35
VIZ_YEAR_REGIONAL=1
VIZ_YEAR_PER_THEME=12
VIZ_DDGS_MAX_REGIONS=12
VIZ_DISCOVER_MAX_RESULTS=150
VIZ_SUPPLEMENT=1
VIZ_SUPPLEMENT_MAX=100
VIZ_ER_BROAD=1
VIZ_NEWSAPI_MAX=80
IMPACT_VIZ_MAX_RECORDS=400
VIZ_YEAR_CACHE=1
VIZ_CACHE_REFRESH=0
EVENTREGISTRY_VIZ_PER_YEAR=32
DISCOVERY_MAX_CANDIDATES=220

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password

DIGEST_FROM_EMAIL=you@gmail.com
DIGEST_TO_EMAIL=recipient@example.com

# Web UI — production: https://morethancode.org; local dev: http://127.0.0.1:5050
SITE_URL=https://morethancode.org
FLASK_SECRET_KEY=change-me-in-production
PORT=5050
VIZ_LOAD_ON_STARTUP=0
# VIZ_CACHE_DIR=/path/to/persistent/cache
